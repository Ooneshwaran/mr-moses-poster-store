# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas cluster connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mrmoses?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here_change_for_production

# Optional Admin Setup Token (used for CLI admin creation or first-time setup)
ADMIN_SETUP_TOKEN=change_this_to_a_secure_token

# Store Information
WHATSAPP_NUMBER=8754126367
STORE_NAME=Mr Moses Poster Store
STORE_TAGLINE=Your Moments, Our Frames

# Persistent Cloud Storage (Cloudinary - Recommended for Production Deployment)
# Sign up at https://cloudinary.com/ and copy credentials from Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
